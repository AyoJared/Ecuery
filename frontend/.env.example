# Clerk — get keys at https://dashboard.clerk.com (API keys page).
# Without these, Clerk runs in "keyless" dev mode and prints a claim link in the console.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where the backend runs; the browser reaches it through /api/ecuery/* (see next.config.ts).
ECUERY_API_URL=http://127.0.0.1:8000
